<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ДПМ: оружие и безопасность</title>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#1c2415;--card:#2f3b22;--khaki:#8f9560;--sand:#e3dcb4;--rust:#d2641f;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--sand);font-family:Oswald,Impact,sans-serif;
background-image:radial-gradient(ellipse 380px 220px at 12% 18%,#2d3a1f 0 60%,transparent 62%),radial-gradient(ellipse 300px 260px at 82% 30%,#3a4a28 0 55%,transparent 57%),radial-gradient(ellipse 420px 200px at 40% 70%,#222c18 0 60%,transparent 62%),radial-gradient(ellipse 260px 240px at 90% 85%,#33401f 0 55%,transparent 57%);background-attachment:fixed}
header{text-align:center;padding:44px 16px 10px}
h1{margin:0;font-size:clamp(40px,9vw,96px);line-height:1;text-shadow:4px 4px 0 #0008;letter-spacing:.04em}
header i{display:block;width:120px;height:6px;margin:16px auto 0;background:var(--rust)}
section{max-width:1200px;margin:0 auto;padding:30px 16px}
h2{margin:0 0 20px;font-size:clamp(26px,4vw,42px);border-bottom:3px solid var(--khaki);padding-bottom:8px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px;perspective:1200px}
.tile{position:relative;background:var(--card);border:2px solid var(--khaki);border-bottom:6px solid var(--rust);padding:10px 10px 14px;cursor:pointer;color:var(--sand);font:inherit;text-align:center;box-shadow:0 10px 22px #0008;transition:transform .15s}
.tile:focus-visible{outline:3px solid var(--rust)}
.tile svg{display:block;width:100%;height:auto;background:radial-gradient(#3d4e2b,#182012);border:1px solid #0006}
.tile span{display:block;margin-top:10px;font-size:22px;font-weight:700;letter-spacing:.03em}
.tile b{position:absolute;top:-10px;left:-10px;width:30px;height:30px;display:grid;place-items:center;background:var(--rust);color:#fff;font-size:15px;border-radius:50%}
#lb{position:fixed;inset:0;z-index:20;background:#0c1008f2;display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:16px}
#lb.on{display:flex}
#lb .big{width:min(94vw,160vh,1000px);background:radial-gradient(#3d4e2b,#182012);border:3px solid var(--khaki);box-shadow:0 20px 60px #000}
#lb .big svg{display:block;width:100%;height:auto}
#lb p{margin:0;font-size:clamp(26px,5vw,48px);font-weight:700}
.nb{position:fixed;top:50%;width:52px;height:64px;margin-top:-32px;background:#0008;border:2px solid var(--khaki);color:var(--sand);font-size:34px;cursor:pointer}
.nb:hover,.nb:focus-visible{background:var(--rust);outline:none}
#pv{left:8px}#nx{right:8px}#cl{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));right:10px;width:48px;height:48px;background:#0008;border:2px solid var(--khaki);color:var(--sand);font-size:26px;cursor:pointer}
footer{height:50px}
@media(prefers-reduced-motion:reduce){.tile{transition:none}}
</style></head><body>
<svg width="0" height="0" style="position:absolute"><defs>
<marker id="g" markerWidth="6" markerHeight="6" refX="4" refY="3" orient="auto"><path d="M0 0L6 3L0 6Z" fill="#7d7"/></marker>
<marker id="r" markerWidth="6" markerHeight="6" refX="4" refY="3" orient="auto"><path d="M0 0L6 3L0 6Z" fill="#d2641f"/></marker>
<marker id="s" markerWidth="6" markerHeight="6" refX="4" refY="3" orient="auto"><path d="M0 0L6 3L0 6Z" fill="#e3dcb4"/></marker></defs></svg>
<header><h1>ДПМ</h1><i></i></header>
<main id="app"></main><footer></footer>
<div id="lb" role="dialog" aria-modal="true"><button id="cl" aria-label="Закрыть">✕</button><button class="nb" id="pv" aria-label="Назад">‹</button><button class="nb" id="nx" aria-label="Вперёд">›</button><div class="big"></div><p></p></div>
<script>
const G='<g fill="#cfd2b5"><rect x="12" y="30" width="86" height="9"/><rect x="66" y="39" width="10" height="22"/><rect x="4" y="32" width="14" height="14"/><path d="M44 39q4 14 18 0" stroke="#cfd2b5" stroke-width="3" fill="none"/></g>';
const PT=[['stock','<polygon points="20,98 205,112 205,176 45,222 20,205" fill="#8a5a2b"/>'],['recv','<rect x="200" y="108" width="265" height="56" rx="4" fill="#33382f"/>'],['cover','<path d="M205 108V92Q210 84 230 84H440L450 108Z" fill="#454b3f"/>'],['barrel','<rect x="465" y="120" width="400" height="13" fill="#2b2f29"/><rect x="800" y="98" width="9" height="24" fill="#2b2f29"/><rect x="852" y="114" width="26" height="25" fill="#2b2f29"/>'],['hand','<rect x="470" y="106" width="190" height="62" rx="8" fill="#8a5a2b"/>'],['gas','<rect x="490" y="92" width="200" height="16" rx="6" fill="#5b6150"/><rect x="690" y="100" width="40" height="30" fill="#2b2f29"/>'],['sight','<rect x="450" y="70" width="46" height="16" fill="#555b4c"/><rect x="470" y="60" width="8" height="12" fill="#555b4c"/>'],['grip','<polygon points="335,164 378,164 366,240 326,240" fill="#7a4e24"/>'],['trig','<path d="M378 164Q380 200 412 196L420 164" fill="none" stroke="#8a8f78" stroke-width="5"/>'],['mag','<path d="M418 164H480Q505 225 520 275L462 285Q450 225 418 164Z" fill="#6b5a2f"/>'],['bolt','<rect x="225" y="134" width="215" height="24" rx="4" fill="rgba(255,255,255,.08)" stroke="#e3dcb4" stroke-width="3" stroke-dasharray="7 5"/>']];
const AK=(k,dy=0,tf='translate(6 38) scale(.21)')=>`<g transform="${tf}">`+PT.map(([n,m])=>k==null?m:n==k?`<g transform="translate(0 ${dy})" style="stroke:#d2641f;stroke-width:5">${m}</g>`:`<g opacity=".28">${m}</g>`).join('')+'</g>';
const gl=(x,y,r,s,inner)=>`<g transform="translate(${x} ${y}) rotate(${r}) scale(${s})">${inner}</g>`;
const T=(x,y,s,t,c='#e3dcb4')=>`<text x="${x}" y="${y}" font-size="${s}" fill="${c}" text-anchor="middle" font-family="Oswald,Impact,sans-serif" font-weight="700">${t}</text>`;
const cart=(x,w,c)=>`<path d="M${x} 44q${w/2} -22 ${w} 0V62H${x}Z" fill="#b87333"/><rect x="${x}" y="62" width="${w}" height="46" fill="${c}"/><rect x="${x-2}" y="108" width="${w+4}" height="6" fill="#aaa"/>`;
const dots=(y,n)=>Array.from({length:n},(_,i)=>`<circle cx="${40+i*17}" cy="${y}" r="7" fill="#e3dcb4"/>`).join('')+`<line x1="${50+n*17}" y1="${y}" x2="185" y2="${y}" stroke="#d2641f" stroke-width="4" marker-end="url(#r)"/>`;
const I=[
['Безопасность',[
['Палец вне скобы',gl(28,22,0,1.2,G+'<ellipse cx="46" cy="25" rx="22" ry="4.5" fill="#e8b88a"/>')+'<circle cx="165" cy="32" r="20" fill="#2e7d32"/><path d="M155 32l8 9 14-17" stroke="#fff" stroke-width="5" fill="none"/>'],
['Не наводить на людей','<circle cx="165" cy="40" r="12" fill="#e3dcb4"/><rect x="155" y="54" width="20" height="52" fill="#e3dcb4"/>'+gl(20,52,0,1,G)+'<circle cx="100" cy="70" r="58" fill="none" stroke="#e33" stroke-width="9"/><line x1="58" y1="112" x2="142" y2="28" stroke="#e33" stroke-width="9"/>'],
['Ствол вверх',gl(40,112,-70,1.1,G)+'<line x1="165" y1="125" x2="165" y2="25" stroke="#7d7" stroke-width="7" marker-end="url(#g)"/>'],
['Магазин долой',AK('mag',75)+'<line x1="104" y1="104" x2="104" y2="132" stroke="#7d7" stroke-width="5" marker-end="url(#g)"/>'],
['Проверь патронник',AK('bolt')+'<circle cx="76" cy="68" r="27" fill="rgba(255,255,255,.1)" stroke="#e3dcb4" stroke-width="6"/><line x1="96" y1="88" x2="120" y2="118" stroke="#e3dcb4" stroke-width="8"/>'],
['Команда «Стоп»','<polygon points="72,12 128,12 168,52 168,88 128,128 72,128 32,88 32,52" fill="#c62828" stroke="#fff" stroke-width="5"/>'+T(100,82,32,'СТОП','#fff')],
['Хранение','<path d="M78 70V50a22 22 0 0 1 44 0V70" stroke="#cfd2b5" stroke-width="11" fill="none"/><rect x="58" y="68" width="84" height="58" rx="8" fill="#c9a227"/><circle cx="100" cy="92" r="8" fill="#222"/><rect x="97" y="96" width="6" height="16" fill="#222"/>']]],
['Автомат Калашникова',[
['Автомат Калашникова',AK(null,0,'translate(6 36) scale(.21)')+'<path d="M20 112h160" stroke="#d2641f" stroke-width="3" stroke-dasharray="3 4"/>'],
['Калибр',cart(50,26,'#d9c27a')+cart(120,18,'#c9b46a')+T(63,132,16,'7,62')+T(129,132,16,'5,45')],
['Одиночный и очередями',dots(45,1)+dots(100,5)],
['Дальность 1000 м','<path d="M30 105Q100 0 170 105" stroke="#e3dcb4" stroke-width="3" fill="none" stroke-dasharray="6 5"/>'+gl(8,92,0,.3,G)+'<circle cx="172" cy="105" r="20" fill="#fff"/><circle cx="172" cy="105" r="13" fill="#c62828"/><circle cx="172" cy="105" r="6" fill="#fff"/>'+T(100,132,20,'1000 м')],
['Пыль, вода, мороз','<text x="40" y="90" font-size="44" text-anchor="middle">🏜️</text><text x="100" y="90" font-size="44" text-anchor="middle">💧</text><text x="160" y="90" font-size="44" text-anchor="middle">❄️</text>'+'<path d="M30 112h140" stroke="#7d7" stroke-width="5"/>'],
['АКМ и АК-74',AK(null,0,'translate(4 6) scale(.19)')+AK(null,0,'translate(4 74) scale(.19)')+T(190,52,16,'АКМ')+T(185,120,16,'АК-74')]]],
['Устройство автомата',[
['Ствол',AK('barrel')],['Магазин',AK('mag')],['Затвор и рама',AK('bolt')],
['Газовая трубка',AK('gas')+'<line x1="110" y1="48" x2="152" y2="48" stroke="#d2641f" stroke-width="4" marker-end="url(#r)"/>'],
['Порядок разборки',[1,2,3,4].map((n,i)=>`<circle cx="${35+i*43}" cy="70" r="17" fill="#d2641f"/>`+T(35+i*43,77,22,n,'#fff')+(i<3?`<line x1="${54+i*43}" y1="70" x2="${58+i*43}" y2="70" stroke="#e3dcb4" stroke-width="4" marker-end="url(#s)"/>`:'')).join('')+'<path d="M30 112h140" stroke="#8f9560" stroke-width="3" stroke-dasharray="5 4"/>'],
['Чистка и смазка','<line x1="25" y1="95" x2="150" y2="95" stroke="#e3dcb4" stroke-width="6"/><rect x="150" y="86" width="30" height="18" fill="#8a5a2b"/><path d="M100 18q-16 24 0 34q16-10 0-34Z" fill="#d2641f"/><path d="M40 60l16 16M56 60l-16 16" stroke="#7d7" stroke-width="5"/>']]],
['Итоги',[
['Главное запомнить','<path d="M100 12L160 32V74Q160 112 100 130Q40 112 40 74V32Z" fill="#4d5a30" stroke="#e3dcb4" stroke-width="5"/><path d="M72 72l20 20 38-44" stroke="#7d7" stroke-width="11" fill="none"/>'],
['Вопросы?','<rect x="30" y="14" width="140" height="84" rx="14" fill="#e3dcb4"/><polygon points="66,98 66,126 98,98" fill="#e3dcb4"/>'+T(100,84,76,'?','#1c2415')]]]];
const app=document.getElementById('app'),all=[];let n=0;
I.forEach(([h,list])=>{const s=document.createElement('section');s.innerHTML=`<h2>${h}</h2><div class="grid"></div>`;
list.forEach(([cap,svg])=>{const i=all.length;n++;const svgs=`<svg viewBox="0 0 200 140" role="img" aria-label="${cap}">${svg}</svg>`;all.push([cap,svgs]);
const b=document.createElement('button');b.className='tile';b.innerHTML=`<b>${n}</b>${svgs}<span>${cap}</span>`;b.onclick=()=>open(i);
b.onmousemove=e=>{if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;const r=b.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;b.style.transform=`rotateY(${x*12}deg) rotateX(${-y*12}deg)`};b.onmouseleave=()=>b.style.transform='';
s.querySelector('.grid').appendChild(b)});app.appendChild(s)});
const lb=document.getElementById('lb');let cur=0;
function open(i){cur=(i+all.length)%all.length;lb.querySelector('.big').innerHTML=all[cur][1];lb.querySelector('p').textContent=cur+1+'. '+all[cur][0];lb.classList.add('on')}
document.getElementById('cl').onclick=()=>lb.classList.remove('on');
document.getElementById('pv').onclick=()=>open(cur-1);document.getElementById('nx').onclick=()=>open(cur+1);
document.addEventListener('keydown',e=>{if(!lb.classList.contains('on'))return;if(e.key=='Escape')lb.classList.remove('on');if(e.key=='ArrowLeft')open(cur-1);if(e.key=='ArrowRight')open(cur+1)});
</script></body></html>
